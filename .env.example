# ==============================================================================
# MCPIC Next.js + PostgreSQL Environment Variables
# Copy to .env.local and replace every placeholder with strong random secrets.
# Generate secrets with: openssl rand -hex 32
# ==============================================================================

# App URL (must match your actual domain in production)
NEXTAUTH_URL="http://localhost:3000"

# Strict CORS allowlist (comma-separated origins, no wildcards)
ALLOWED_ORIGINS="http://localhost:3000"

# Cryptographically random 64-char hex secret for NextAuth JWT signing
NEXTAUTH_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"

# Cryptographically random 64-char hex key (32 bytes) for encrypting MFA TOTP secrets at rest
MFA_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"

# Cryptographically random secret for HMAC-SHA256 webhook signature verification
WEBHOOK_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"

# PostgreSQL connection strings
# DATABASE_ADMIN_URL is used ONLY by `npm run db:setup` to create tables, roles, and RLS policies.
DATABASE_ADMIN_URL="postgresql://postgres:CHANGE_ME_STRONG_DB_PASS@localhost:5432/mcpic"

# DATABASE_URL is used by the Next.js runtime with the least-privilege `mcpic_app` role
# so PostgreSQL Row Level Security (RLS) is strictly enforced on every query.
DATABASE_URL="postgresql://mcpic_app:CHANGE_ME_STRONG_APP_PASS@localhost:5432/mcpic"

# Password assigned to the `mcpic_app` DB role when running `npm run db:setup`
DB_APP_PASSWORD="CHANGE_ME_STRONG_APP_PASS"

# Optional: Server-only ImgBB API key (never exposed to browser).
# If omitted, validated uploads are stored safely in local ./uploads and served via /api/uploads/[filename].
IMGBB_API_KEY=""

# Optional: SMTP settings for contact form, email verification, and password resets
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MCPIC <noreply@mcpscictclub.com>"
CONTACT_RECEIVER_EMAIL="contact@mcpscictclub.com"

# Initial admin seed credentials (used ONLY by `npm run db:seed`, never hardcoded)
SEED_ADMIN_NAME="MCPIC Admin"
SEED_ADMIN_EMAIL="admin@mcpscictclub.com"
SEED_ADMIN_PASSWORD=""
